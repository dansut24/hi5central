---
export interface Props {
  title: string;
  value: string | number;
  description?: string;
}

const {
  title,
  value,
  description = ""
} = Astro.props;
---

<div
  class="rounded-2xl border p-6"
  style="
    background: var(--hi5-card);
    border-color: var(--hi5-border);
  "
>
  <p
    class="text-sm font-semibold"
    style="color: var(--hi5-muted);"
  >
    {title}
  </p>

  <p
    class="mt-2 text-3xl font-black"
    style="color: var(--hi5-fg);"
  >
    {value}
  </p>

  {
    description && (
      <p
        class="mt-2 text-sm"
        style="color: var(--hi5-muted);"
      >
        {description}
      </p>
    )
  }
</div>
