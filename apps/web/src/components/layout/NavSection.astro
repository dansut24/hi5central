---
const { title, items = [] } = Astro.props;
---

<section class="space-y-2">
  <p class="px-3 text-[0.68rem] font-black uppercase tracking-[0.22em] text-slate-500">
    {title}
  </p>

  <div class="grid gap-1">
    {items.map((item) => (
      <a
        href={item.href}
        class="group flex items-center gap-3 rounded-2xl px-3 py-2.5 text-sm font-bold text-slate-300 transition hover:bg-white/10 hover:text-white"
      >
        <span class="grid h-8 w-8 place-items-center rounded-xl border border-white/10 bg-white/[0.045] text-xs text-blue-200 transition group-hover:border-blue-300/30 group-hover:bg-blue-400/10">
          {item.icon}
        </span>

        <span>{item.label}</span>
      </a>
    ))}
  </div>
</section>
