---
import NavSection from "./NavSection.astro";

const control = [
  { href: "/dashboard", label: "Dashboard", icon: "⌂" },
  { href: "/devices", label: "Devices", icon: "◫" },
  { href: "/remote", label: "Remote Access", icon: "↗" },
  { href: "/software", label: "Software", icon: "▣" },
  { href: "/patching", label: "Patching", icon: "↻" }
];

const service = [
  { href: "/tickets", label: "Tickets", icon: "✉" },
  { href: "/knowledge", label: "Knowledge", icon: "◨" }
];

const admin = [
  { href: "/admin/users", label: "Users", icon: "◎" },
  { href: "/admin/branding", label: "Branding", icon: "◐" },
  { href: "/admin/integrations", label: "Integrations", icon: "⚭" },
  { href: "/admin/integrations/ai", label: "AI", icon: "✦" }
];

const system = [
  { href: "/audit", label: "Audit Logs", icon: "≡" },
  { href: "/settings", label: "Settings", icon: "⚙" }
];
---

<aside class="hidden w-[292px] shrink-0 border-r border-white/10 bg-slate-950/75 p-4 backdrop-blur-2xl xl:block">
  <a href="/dashboard" class="flex items-center gap-3 rounded-[1.45rem] border border-white/10 bg-white/[0.055] p-3 shadow-2xl shadow-black/20">
    <div class="grid h-11 w-11 place-items-center rounded-2xl bg-white text-sm font-black text-slate-950 shadow-lg shadow-blue-500/10">
      H5
    </div>

    <div class="min-w-0">
      <p class="truncate text-sm font-black text-white">Hi5Central</p>
      <p id="tenant-label" class="truncate text-xs font-semibold text-slate-400">Managed IT Platform</p>
    </div>
  </a>

  <nav class="mt-6 space-y-6">
    <NavSection title="Control" items={control} />
    <NavSection title="Service" items={service} />
    <NavSection title="Admin" items={admin} />
    <NavSection title="System" items={system} />
  </nav>

  <div class="mt-8 rounded-[1.45rem] border border-blue-400/15 bg-blue-400/10 p-4">
    <p class="text-xs font-black uppercase tracking-wide text-blue-200">AI Assistant</p>
    <p class="mt-2 text-xs leading-5 text-slate-300">
      Configure tenant AI providers for summaries, explanations, and future automation.
    </p>
    <a href="/admin/integrations/ai" class="mt-3 inline-flex rounded-xl bg-white px-3 py-2 text-xs font-black text-slate-950">
      Configure AI
    </a>
  </div>
</aside>

<script>
  const host = window.location.hostname;
  const tenant = host.includes(".") ? host.split(".")[0] : "preview";
  const label = document.getElementById("tenant-label");

  if (label) {
    label.textContent = tenant === "hi5central" || tenant === "www"
      ? "Managed IT Platform"
      : `${tenant}.hi5central.com`;
  }
</script>
