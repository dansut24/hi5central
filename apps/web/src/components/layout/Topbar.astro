---
const { title = "Dashboard", description = "" } = Astro.props;

const mobileNav = [
  { href: "/dashboard", label: "Dashboard" },
  { href: "/devices", label: "Devices" },
  { href: "/patching", label: "Patching" },
  { href: "/tickets", label: "Tickets" },
  { href: "/admin/integrations", label: "Integrations" },
  { href: "/admin/branding", label: "Branding" }
];
---

<header class="sticky top-0 z-30 border-b border-white/10 bg-slate-950/72 px-4 py-3 backdrop-blur-2xl sm:px-6">
  <div class="mx-auto flex max-w-[1500px] items-center justify-between gap-3">
    <div class="min-w-0">
      <p class="text-[0.68rem] font-black uppercase tracking-[0.22em] text-blue-300">Tenant Portal</p>
      <h1 class="truncate text-xl font-black tracking-tight text-white">{title}</h1>
      {description && (
        <p class="mt-1 hidden max-w-2xl truncate text-xs text-slate-400 md:block">
          {description}
        </p>
      )}
    </div>

    <div class="hidden min-w-[320px] max-w-[520px] flex-1 lg:block">
      <label class="flex items-center gap-2 rounded-2xl border border-white/10 bg-white/[0.055] px-3 py-2 text-sm text-slate-400">
        <span>⌕</span>
        <input
          class="w-full bg-transparent text-sm text-white outline-none placeholder:text-slate-500"
          placeholder="Search devices, users, tickets..."
        />
      </label>
    </div>

    <div class="flex items-center gap-2">
      <button class="grid h-10 w-10 place-items-center rounded-2xl border border-white/10 bg-white/[0.055] text-sm text-slate-200 transition hover:bg-white/10">
        🔔
      </button>

      <a href="/admin/integrations" class="hidden rounded-2xl border border-white/10 bg-white/[0.055] px-3 py-2 text-xs font-bold text-slate-200 transition hover:bg-white/10 md:block">
        Integrations
      </a>

      <button class="flex items-center gap-2 rounded-2xl bg-white px-3 py-2 text-xs font-black text-slate-950 shadow-lg shadow-white/10">
        <span class="grid h-5 w-5 place-items-center rounded-full bg-slate-950 text-[0.6rem] text-white">DS</span>
        <span class="hidden sm:inline">Account</span>
      </button>
    </div>
  </div>

  <div class="mx-auto mt-3 max-w-[1500px] lg:hidden">
    <label class="flex items-center gap-2 rounded-2xl border border-white/10 bg-white/[0.055] px-3 py-2 text-sm text-slate-400">
      <span>⌕</span>
      <input
        class="w-full bg-transparent text-sm text-white outline-none placeholder:text-slate-500"
        placeholder="Search..."
      />
    </label>
  </div>

  <nav class="mx-auto mt-3 flex max-w-[1500px] gap-2 overflow-x-auto pb-1 xl:hidden">
    {mobileNav.map((item) => (
      <a href={item.href} class="shrink-0 rounded-2xl border border-white/10 bg-white/[0.055] px-3 py-2 text-xs font-bold text-slate-200">
        {item.label}
      </a>
    ))}
  </nav>
</header>
