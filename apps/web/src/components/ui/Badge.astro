---
const { variant = "default" } = Astro.props;

const classes = {
  default: "rounded-full px-2.5 py-1 text-xs font-semibold",
  success: "rounded-full px-2.5 py-1 text-xs font-semibold",
  warning: "rounded-full px-2.5 py-1 text-xs font-semibold",
  danger: "rounded-full px-2.5 py-1 text-xs font-semibold",
  dark: "rounded-full px-2.5 py-1 text-xs font-semibold"
};

const styles = {
  default: "background: var(--hi5-card-soft); color: var(--hi5-muted); border: 1px solid var(--hi5-border);",
  success: "background: color-mix(in srgb, var(--hi5-success) 12%, transparent); color: var(--hi5-success); border: 1px solid color-mix(in srgb, var(--hi5-success) 22%, transparent);",
  warning: "background: color-mix(in srgb, var(--hi5-warning) 12%, transparent); color: var(--hi5-warning); border: 1px solid color-mix(in srgb, var(--hi5-warning) 22%, transparent);",
  danger: "background: color-mix(in srgb, var(--hi5-danger) 12%, transparent); color: var(--hi5-danger); border: 1px solid color-mix(in srgb, var(--hi5-danger) 22%, transparent);",
  dark: "background: rgba(16, 185, 129, 0.12); color: #6ee7b7; border: 1px solid rgba(110, 231, 183, 0.22);"
};

const className = classes[variant] ?? classes.default;
const style = styles[variant] ?? styles.default;
---

<span class={className} style={style}>
  <slot />
</span>
