---
const {
  label,
  value,
  detail
} = Astro.props;
---

<article class="rounded-2xl border border-slate-200 bg-white/85 p-5 shadow-sm backdrop-blur-xl">
  <p class="text-sm font-medium text-slate-500">{label}</p>
  <p class="mt-2 text-3xl font-bold tracking-tight text-slate-950">{value}</p>
  <p class="mt-4 text-sm text-slate-500">{detail}</p>
</article>
