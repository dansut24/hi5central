---
const {
  label,
  value,
  detail
} = Astro.props;
---

<article
  class="rounded-3xl border p-5 shadow-[var(--hi5-shadow-soft)]"
  style="background: var(--hi5-card); border-color: var(--hi5-border);"
>
  <p class="text-sm font-semibold" style="color: var(--hi5-muted);">{label}</p>
  <p class="mt-2 text-3xl font-black tracking-tight" style="color: var(--hi5-fg);">{value}</p>
  <p class="mt-4 text-sm" style="color: var(--hi5-muted);">{detail}</p>
</article>
