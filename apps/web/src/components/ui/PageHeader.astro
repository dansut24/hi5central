---
const {
  eyebrow = "Acme Support · Production",
  title = "Dashboard"
} = Astro.props;
---

<header
  class="sticky top-0 z-10 hidden border-b px-5 py-4 backdrop-blur-xl lg:block lg:px-8"
  style="background: color-mix(in srgb, var(--hi5-card) 82%, transparent); border-color: var(--hi5-border);"
>
  <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
    <div>
      <p class="text-sm font-bold" style="color: var(--hi5-primary);">{eyebrow}</p>
      <h2 class="text-2xl font-black tracking-tight md:text-3xl" style="color: var(--hi5-fg);">{title}</h2>
    </div>

    <div class="flex gap-3">
      <slot name="actions" />
    </div>
  </div>
</header>
