---
const { title = "Dashboard" } = Astro.props;
---

<header
  class="sticky top-0 z-20 border-b px-4 py-3 backdrop-blur-xl lg:hidden"
  style="background: color-mix(in srgb, var(--hi5-card) 88%, transparent); border-color: var(--hi5-border);"
>
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-3">
      <div
        class="flex h-10 w-10 items-center justify-center rounded-2xl text-sm font-black text-white shadow-lg"
        style="background: linear-gradient(135deg, var(--hi5-primary), #7c3aed);"
      >
        H5
      </div>

      <div>
        <p class="text-xs font-bold" style="color: var(--hi5-primary);">Hi5Central</p>
        <h1 class="text-lg font-black tracking-tight" style="color: var(--hi5-fg);">{title}</h1>
      </div>
    </div>

    <button
      id="mobile-menu-button"
      class="rounded-xl border px-3 py-2 text-sm font-bold shadow-sm"
      style="background: var(--hi5-card); border-color: var(--hi5-border); color: var(--hi5-fg);"
      type="button"
      aria-label="Open navigation menu"
    >
      Menu
    </button>
  </div>
</header>
