---
const { devices = [] } = Astro.props;
---

<div class="space-y-3 md:hidden">
  {devices.map((device) => (
    <article
      class="rounded-3xl border p-4 shadow-[var(--hi5-shadow-soft)]"
      style="background: var(--hi5-card); border-color: var(--hi5-border);"
    >
      <div class="flex items-start justify-between gap-3">
        <div>
          <h3 class="font-black" style="color: var(--hi5-fg);">{device.name}</h3>
          <p class="mt-1 text-sm" style="color: var(--hi5-muted);">{device.user}</p>
          <p class="mt-1 text-sm" style="color: var(--hi5-muted);">{device.os}</p>
        </div>

        <span
          class="rounded-full px-2.5 py-1 text-xs font-bold"
          style={device.status === "Online"
            ? "background: color-mix(in srgb, var(--hi5-success) 12%, transparent); color: var(--hi5-success); border: 1px solid color-mix(in srgb, var(--hi5-success) 22%, transparent);"
            : "background: var(--hi5-card-soft); color: var(--hi5-muted); border: 1px solid var(--hi5-border);"}
        >
          {device.status}
        </span>
      </div>

      <div class="mt-4 grid grid-cols-2 gap-3">
        <div
          class="rounded-2xl border p-3"
          style="background: var(--hi5-card-soft); border-color: var(--hi5-border);"
        >
          <p class="text-xs" style="color: var(--hi5-muted);">Health</p>
          <p class="mt-1 text-sm font-black" style="color: var(--hi5-fg);">{device.health}</p>
        </div>

        <div
          class="rounded-2xl border p-3"
          style="background: var(--hi5-card-soft); border-color: var(--hi5-border);"
        >
          <p class="text-xs" style="color: var(--hi5-muted);">Patches</p>
          <p class="mt-1 text-sm font-black" style="color: var(--hi5-fg);">{device.patches}</p>
        </div>
      </div>
    </article>
  ))}
</div>
