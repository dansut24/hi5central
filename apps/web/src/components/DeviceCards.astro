---
const { devices = [] } = Astro.props;
---

<div class="space-y-3 md:hidden">
  {devices.map((device) => (
    <article class="rounded-2xl border border-slate-200 bg-white/85 p-4 shadow-sm backdrop-blur-xl">
      <div class="flex items-start justify-between gap-3">
        <div>
          <h3 class="font-bold text-slate-950">{device.name}</h3>
          <p class="mt-1 text-xs text-slate-500">{device.user}</p>
          <p class="mt-1 text-xs text-slate-500">{device.os}</p>
        </div>

        <span class={device.status === "Online"
          ? "rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-700 ring-1 ring-emerald-200"
          : "rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-500 ring-1 ring-slate-200"}>
          {device.status}
        </span>
      </div>

      <div class="mt-4 grid grid-cols-2 gap-3">
        <div class="rounded-xl bg-slate-50 p-3">
          <p class="text-xs text-slate-500">Health</p>
          <p class="mt-1 text-sm font-bold text-slate-950">{device.health}</p>
        </div>

        <div class="rounded-xl bg-slate-50 p-3">
          <p class="text-xs text-slate-500">Patches</p>
          <p class="mt-1 text-sm font-bold text-slate-950">{device.patches}</p>
        </div>
      </div>
    </article>
  ))}
</div>
