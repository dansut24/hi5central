---
import ThemeSwitcher from "./ThemeSwitcher.astro";
---

<div
  id="mobile-drawer-overlay"
  class="fixed inset-0 z-40 hidden backdrop-blur-sm lg:hidden"
  style="background: rgba(2, 6, 23, 0.55);"
></div>

<aside
  id="mobile-drawer"
  class="fixed left-0 top-0 z-50 h-full w-80 max-w-[85vw] -translate-x-full border-r p-5 shadow-2xl transition-transform duration-200 lg:hidden"
  style="background: var(--hi5-sidebar); border-color: var(--hi5-sidebar-border);"
>
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-3">
      <div
        class="flex h-10 w-10 items-center justify-center rounded-2xl text-sm font-black text-white"
        style="background: linear-gradient(135deg, var(--hi5-primary), #7c3aed);"
      >
        H5
      </div>

      <div>
        <p class="font-black" style="color: var(--hi5-fg);">Hi5Central</p>
        <p class="text-xs" style="color: var(--hi5-muted);">Control Platform</p>
      </div>
    </div>

    <button
      id="mobile-drawer-close"
      class="rounded-xl border px-3 py-2 text-sm font-bold"
      style="background: var(--hi5-card); border-color: var(--hi5-border); color: var(--hi5-fg);"
      type="button"
      aria-label="Close navigation menu"
    >
      Close
    </button>
  </div>

  <nav class="mt-8 space-y-1">
    <a class="block rounded-xl px-3 py-3 text-sm font-bold text-white shadow-sm" style="background: var(--hi5-navy);" href="/">Dashboard</a>
    <a class="block rounded-xl px-3 py-3 text-sm font-semibold hover:bg-black/5" style="color: var(--hi5-muted);" href="#">Devices</a>
    <a class="block rounded-xl px-3 py-3 text-sm font-semibold hover:bg-black/5" style="color: var(--hi5-muted);" href="#">Remote Access</a>
    <a class="block rounded-xl px-3 py-3 text-sm font-semibold hover:bg-black/5" style="color: var(--hi5-muted);" href="#">Patching</a>
    <a class="block rounded-xl px-3 py-3 text-sm font-semibold hover:bg-black/5" style="color: var(--hi5-muted);" href="#">Backup</a>
    <a class="block rounded-xl px-3 py-3 text-sm font-semibold hover:bg-black/5" style="color: var(--hi5-muted);" href="#">Policies</a>
    <a class="block rounded-xl px-3 py-3 text-sm font-semibold hover:bg-black/5" style="color: var(--hi5-muted);" href="#">Reports</a>
    <a class="block rounded-xl px-3 py-3 text-sm font-semibold hover:bg-black/5" style="color: var(--hi5-muted);" href="#">Settings</a>
  </nav>

  <div class="mt-6">
    <p class="mb-2 text-xs font-bold uppercase tracking-wide" style="color: var(--hi5-muted);">Theme</p>
    <ThemeSwitcher compact={true} />
  </div>

  <div
    class="absolute bottom-5 left-5 right-5 rounded-3xl border p-4 shadow-[var(--hi5-shadow-soft)]"
    style="background: var(--hi5-primary-soft); border-color: color-mix(in srgb, var(--hi5-primary) 18%, transparent);"
  >
    <p class="text-sm font-bold" style="color: var(--hi5-fg);">Secure tenant mode</p>
    <p class="mt-1 text-xs leading-5" style="color: var(--hi5-muted);">Every technician action will be audited.</p>
  </div>
</aside>

<script>
  const menuButton = document.getElementById("mobile-menu-button");
  const drawer = document.getElementById("mobile-drawer");
  const overlay = document.getElementById("mobile-drawer-overlay");
  const closeButton = document.getElementById("mobile-drawer-close");

  function openDrawer() {
    drawer?.classList.remove("-translate-x-full");
    overlay?.classList.remove("hidden");
    document.body.style.overflow = "hidden";
  }

  function closeDrawer() {
    drawer?.classList.add("-translate-x-full");
    overlay?.classList.add("hidden");
    document.body.style.overflow = "";
  }

  menuButton?.addEventListener("click", openDrawer);
  closeButton?.addEventListener("click", closeDrawer);
  overlay?.addEventListener("click", closeDrawer);

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      closeDrawer();
    }
  });
</script>
