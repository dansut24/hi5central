---
import "../styles/global.css";

const {
  title = "Dashboard",
} = Astro.props;

const currentPath = Astro.url.pathname;

const navItems = [
  { label: "Dashboard", href: "/dashboard" },
  { label: "Devices", href: "/devices" },
  { label: "Remote Access", href: "#" },
  { label: "Patching", href: "#" },
  { label: "Backup", href: "#" },
  { label: "Policies", href: "#" },
  { label: "Status", href: "https://status.hi5central.com" },
  { label: "Settings", href: "#" }
];

function navClass(href) {
  const active = href !== "#" && href.startsWith("/") && currentPath.startsWith(href);

  return active
    ? "block rounded-2xl bg-blue-500/15 px-3 py-2.5 text-sm font-semibold text-blue-200 ring-1 ring-blue-400/20"
    : "block rounded-2xl px-3 py-2.5 text-sm font-semibold text-slate-300 hover:bg-white/5 hover:text-white";
}

function mobileNavClass(href) {
  const active = href !== "#" && href.startsWith("/") && currentPath.startsWith(href);

  return active
    ? "block rounded-2xl bg-blue-500/15 px-3 py-3 text-sm font-semibold text-blue-200 ring-1 ring-blue-400/20"
    : "block rounded-2xl px-3 py-3 text-sm font-semibold text-slate-300 hover:bg-white/5 hover:text-white";
}
---

<div class="h-[100dvh] max-h-[100dvh] min-h-[100dvh] overflow-hidden">
  <header class="z-40 shrink-0 p-3">
    <div class="hi5-panel flex h-14 items-center gap-2 rounded-3xl px-3">
      <button
        id="mobile-menu-button"
        type="button"
        class="flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl border hi5-border bg-white/5 lg:hidden"
        aria-label="Open navigation"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
          <path d="M4 7h16"></path>
          <path d="M4 12h16"></path>
          <path d="M4 17h16"></path>
        </svg>
      </button>

      <a href="/dashboard" class="flex min-w-0 items-center gap-2">
        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-2xl border border-blue-400/20 bg-blue-500/10 text-sm font-black text-blue-300">
          H5
        </span>

        <span class="min-w-0">
          <span class="block truncate text-sm font-black text-white">Hi5Central RMM</span>
          <span class="block truncate text-xs text-slate-400">{title}</span>
        </span>
      </a>

      <div class="flex-1"></div>

      <button class="hidden h-10 w-10 items-center justify-center rounded-2xl border hi5-border bg-white/5 sm:flex" aria-label="Search">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>
      </button>

      <button class="hidden h-10 w-10 items-center justify-center rounded-2xl border hi5-border bg-white/5 sm:flex" aria-label="Notifications">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9"></path>
          <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
        </svg>
      </button>

      <button class="flex h-10 w-10 items-center justify-center rounded-2xl border border-blue-500/40 bg-blue-500/10 text-sm font-black text-blue-300">
        D
      </button>
    </div>
  </header>

  <div class="flex h-[calc(100dvh-80px)] min-h-0 overflow-hidden px-3 pb-3">
    <aside class="hidden w-64 shrink-0 overflow-y-auto border-r hi5-border pr-3 lg:block">
      <nav class="space-y-1">
        {navItems.map((item) => (
          <a href={item.href} class={navClass(item.href)}>
            {item.label}
          </a>
        ))}
      </nav>
    </aside>

    <main class="min-w-0 flex-1 overflow-y-auto overscroll-contain pb-[calc(5rem+env(safe-area-inset-bottom,0px))] lg:pl-4">
      <slot />
    </main>
  </div>

  <div id="mobile-overlay" class="fixed inset-0 z-50 hidden bg-black/50 backdrop-blur-sm lg:hidden"></div>

  <aside
    id="mobile-drawer"
    class="fixed left-0 top-0 z-[60] h-full w-[84vw] max-w-[320px] -translate-x-full hi5-panel rounded-none border-r hi5-border p-4 transition-transform duration-200 lg:hidden"
  >
    <div class="flex items-center justify-between border-b hi5-border pb-4">
      <div>
        <p class="text-sm font-black text-white">Navigation</p>
        <p class="text-xs text-slate-400">Hi5Central RMM</p>
      </div>

      <button id="mobile-drawer-close" type="button" class="flex h-9 w-9 items-center justify-center rounded-xl border hi5-border bg-white/5">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
          <path d="M18 6 6 18"></path>
          <path d="M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <nav class="mt-4 space-y-1">
      {navItems.map((item) => (
        <a href={item.href} class={mobileNavClass(item.href)}>
          {item.label}
        </a>
      ))}
    </nav>
  </aside>
</div>

<script>
  (() => {
    const button = document.getElementById("mobile-menu-button");
    const drawer = document.getElementById("mobile-drawer");
    const overlay = document.getElementById("mobile-overlay");
    const close = document.getElementById("mobile-drawer-close");

    function openDrawer() {
      drawer?.classList.remove("-translate-x-full");
      overlay?.classList.remove("hidden");
      document.body.style.overflow = "hidden";
    }

    function closeDrawer() {
      drawer?.classList.add("-translate-x-full");
      overlay?.classList.add("hidden");
      document.body.style.overflow = "";
    }

    button?.addEventListener("click", openDrawer);
    close?.addEventListener("click", closeDrawer);
    overlay?.addEventListener("click", closeDrawer);
  })();
</script>
