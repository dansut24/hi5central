---
import ThemeSwitcher from "../components/ThemeSwitcher.astro";
import UserMenu from "../components/UserMenu.astro";

export interface Props {
  title?: string;
}

const { title = "Dashboard" } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Hi5Central</title>
  </head>

  <body>
    <div class="min-h-screen flex">
      <aside
        class="hidden md:flex w-72 flex-col border-r"
        style="
          background: var(--hi5-card);
          border-color: var(--hi5-border);
        "
      >
        <div class="p-6">
          <h1
            class="text-2xl font-black"
            style="color: var(--hi5-primary);"
          >
            Hi5Central
          </h1>
        </div>

        <nav class="flex-1 px-4 space-y-2">
          <a
            href="/dashboard"
            class="block rounded-xl px-4 py-3 transition hover:bg-black/5"
          >
            Dashboard
          </a>

          <a
            href="#"
            class="block rounded-xl px-4 py-3 transition hover:bg-black/5"
          >
            Devices
          </a>

          <a
            href="#"
            class="block rounded-xl px-4 py-3 transition hover:bg-black/5"
          >
            Remote Access
          </a>

          <a
            href="#"
            class="block rounded-xl px-4 py-3 transition hover:bg-black/5"
          >
            Patching
          </a>

          <a
            href="#"
            class="block rounded-xl px-4 py-3 transition hover:bg-black/5"
          >
            Backup
          </a>

          <a
            href="#"
            class="block rounded-xl px-4 py-3 transition hover:bg-black/5"
          >
            Policies
          </a>

          <a
            href="#"
            class="block rounded-xl px-4 py-3 transition hover:bg-black/5"
          >
            Settings
          </a>
        </nav>
      </aside>

      <div class="flex flex-1 flex-col">
        <header
          class="flex items-center justify-between border-b px-6 py-4"
          style="
            background: var(--hi5-card);
            border-color: var(--hi5-border);
          "
        >
          <h2
            class="text-xl font-bold"
            style="color: var(--hi5-fg);"
          >
            {title}
          </h2>

          <div class="flex items-center gap-3">
            <ThemeSwitcher compact={true} />
            <UserMenu />
          </div>
        </header>

        <main class="flex-1 p-6">
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>
