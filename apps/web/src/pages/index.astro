---
import "../styles/global.css";

import MobileHeader from "../components/MobileHeader.astro";
import MobileDrawer from "../components/MobileDrawer.astro";
import DeviceCards from "../components/DeviceCards.astro";

import Button from "../components/ui/Button.astro";
import Card from "../components/ui/Card.astro";
import Badge from "../components/ui/Badge.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import StatCard from "../components/ui/StatCard.astro";

const metrics = [
  {
    label: "Total Devices",
    value: "128",
    detail: "Across 4 customer sites"
  },
  {
    label: "Online Devices",
    value: "114",
    detail: "89% currently reachable"
  },
  {
    label: "Patch Exposure",
    value: "23",
    detail: "7 high-priority updates"
  },
  {
    label: "Active Sessions",
    value: "4",
    detail: "2 remote, 2 background"
  }
];

const devices = [
  {
    name: "LON-WKS-024",
    user: "Sarah Thompson",
    os: "Windows 11 Pro",
    status: "Online",
    health: "Good",
    patches: 2
  },
  {
    name: "LON-SRV-002",
    user: "Infrastructure",
    os: "Windows Server 2022",
    status: "Online",
    health: "Warning",
    patches: 8
  },
  {
    name: "MAC-FIN-011",
    user: "James Patel",
    os: "macOS",
    status: "Offline",
    health: "Unknown",
    patches: 0
  }
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Hi5Central Dashboard</title>
  </head>

  <body>
    <MobileHeader title="Dashboard" />
    <MobileDrawer />

    <div class="min-h-screen">
      <aside class="fixed left-0 top-0 hidden h-full w-72 border-r border-slate-200 bg-white/80 p-6 backdrop-blur-xl lg:block">
        <div class="flex items-center gap-3">
          <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-indigo-600 text-lg font-bold text-white shadow-lg shadow-indigo-200">
            H5
          </div>
          <div>
            <h1 class="text-lg font-bold tracking-tight text-slate-950">Hi5Central</h1>
            <p class="text-xs text-slate-500">Control Platform</p>
          </div>
        </div>

        <nav class="mt-8 space-y-1">
          <a class="block rounded-xl bg-slate-950 px-3 py-2.5 text-sm font-semibold text-white" href="/">Dashboard</a>
          <a class="block rounded-xl px-3 py-2.5 text-sm font-semibold text-slate-600 hover:bg-slate-100" href="#">Devices</a>
          <a class="block rounded-xl px-3 py-2.5 text-sm font-semibold text-slate-600 hover:bg-slate-100" href="#">Remote Access</a>
          <a class="block rounded-xl px-3 py-2.5 text-sm font-semibold text-slate-600 hover:bg-slate-100" href="#">Patching</a>
          <a class="block rounded-xl px-3 py-2.5 text-sm font-semibold text-slate-600 hover:bg-slate-100" href="#">Backup</a>
          <a class="block rounded-xl px-3 py-2.5 text-sm font-semibold text-slate-600 hover:bg-slate-100" href="#">Policies</a>
          <a class="block rounded-xl px-3 py-2.5 text-sm font-semibold text-slate-600 hover:bg-slate-100" href="#">Reports</a>
          <a class="block rounded-xl px-3 py-2.5 text-sm font-semibold text-slate-600 hover:bg-slate-100" href="#">Settings</a>
        </nav>

        <div class="absolute bottom-6 left-6 right-6 rounded-2xl border border-indigo-100 bg-indigo-50 p-4">
          <p class="text-sm font-semibold text-indigo-950">Secure tenant mode</p>
          <p class="mt-1 text-xs leading-5 text-indigo-700">Every technician action will be audited.</p>
        </div>
      </aside>

      <main class="lg:pl-72">
        <PageHeader eyebrow="Acme Support · Production" title="Dashboard">
          <Button slot="actions" variant="secondary">View Docs</Button>
          <Button slot="actions" variant="primary">New Session</Button>
        </PageHeader>

        <section class="p-4 md:p-6 lg:p-8">
          <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
            {metrics.map((metric) => (
              <StatCard
                label={metric.label}
                value={metric.value}
                detail={metric.detail}
              />
            ))}
          </div>

          <div class="mt-6 grid gap-6 xl:grid-cols-[1.6fr_0.9fr]">
            <Card>
              <SectionHeader
                title="Devices"
                description="Initial dashboard preview. Live data will come from the Hono API later."
              />

              <div class="p-4 md:hidden">
                <DeviceCards devices={devices} />
              </div>

              <div class="hidden overflow-x-auto md:block">
                <table class="w-full text-left text-sm">
                  <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
                    <tr>
                      <th class="px-5 py-3">Device</th>
                      <th class="px-5 py-3">Status</th>
                      <th class="px-5 py-3">Health</th>
                      <th class="px-5 py-3">Patches</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-slate-100">
                    {devices.map((device) => (
                      <tr class="hover:bg-slate-50">
                        <td class="px-5 py-4">
                          <div class="font-semibold text-slate-950">{device.name}</div>
                          <div class="text-xs text-slate-500">{device.user} · {device.os}</div>
                        </td>
                        <td class="px-5 py-4">
                          {device.status === "Online" ? (
                            <Badge variant="success">Online</Badge>
                          ) : (
                            <Badge>Offline</Badge>
                          )}
                        </td>
                        <td class="px-5 py-4 text-slate-700">{device.health}</td>
                        <td class="px-5 py-4 text-slate-700">{device.patches}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </Card>

            <aside class="space-y-6">
              <section class="rounded-2xl border border-slate-900 bg-slate-950 p-5 text-white shadow-sm">
                <div class="flex items-center justify-between">
                  <h3 class="text-lg font-bold">Remote Access</h3>
                  <Badge variant="dark">Ready</Badge>
                </div>

                <p class="mt-3 text-sm leading-6 text-slate-300">
                  Sessions will use separate stream and input paths to avoid laggy mouse movement.
                </p>

                <div class="mt-5 grid grid-cols-2 gap-3">
                  <Button variant="secondary">Connect</Button>
                  <Button variant="dark">Background</Button>
                </div>
              </section>

              <Card class="p-5">
                <h3 class="text-lg font-bold text-slate-950">Backup Status</h3>
                <p class="mt-2 text-sm text-slate-500">
                  Managed customers will use Hi5Central-managed encrypted object storage.
                </p>

                <div class="mt-4 rounded-xl bg-slate-50 p-4">
                  <p class="text-sm font-semibold text-slate-950">Protected Devices</p>
                  <p class="mt-1 text-2xl font-bold text-slate-950">0</p>
                  <p class="mt-1 text-xs text-slate-500">Backup engine will be added later.</p>
                </div>
              </Card>
            </aside>
          </div>
        </section>
      </main>
    </div>
  </body>
</html>
