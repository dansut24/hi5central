---
import "../../styles/global.css";

import AppShell from "../../components/AppShell.astro";
import DeviceCards from "../../components/DeviceCards.astro";
import ThemeSwitcher from "../../components/ThemeSwitcher.astro";
import DashboardMetricsClient from "../../components/dashboard/DashboardMetricsClient.jsx";

import Button from "../../components/ui/Button.astro";
import Card from "../../components/ui/Card.astro";
import Badge from "../../components/ui/Badge.astro";
import PageHeader from "../../components/ui/PageHeader.astro";
import SectionHeader from "../../components/ui/SectionHeader.astro";

const devices = [
  {
    name: "LON-WKS-024",
    user: "Sarah Thompson",
    os: "Windows 11 Pro",
    status: "Online",
    health: "Good",
    patches: 2
  },
  {
    name: "LON-SRV-002",
    user: "Infrastructure",
    os: "Windows Server 2022",
    status: "Online",
    health: "Warning",
    patches: 8
  },
  {
    name: "MAC-FIN-011",
    user: "James Patel",
    os: "macOS",
    status: "Offline",
    health: "Unknown",
    patches: 0
  }
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Hi5Central Dashboard</title>
  </head>

  <body>
    <AppShell title="Dashboard">
      <PageHeader eyebrow="Acme Support · Production" title="Dashboard">
        <div slot="actions" class="flex items-center gap-3">
          <Button variant="secondary">View Docs</Button>
          <Button variant="primary">New Session</Button>
        </div>
      </PageHeader>

      <section class="p-4 md:p-6 lg:p-8">
        <DashboardMetricsClient client:load />

        <div class="mt-6 grid gap-6 xl:grid-cols-[1.6fr_0.9fr]">
          <Card>
            <SectionHeader
              title="Devices"
              description="Initial dashboard preview. Live data will come from the Hono API later."
            />

            <div class="p-4 md:hidden">
              <DeviceCards devices={devices} />
            </div>

            <div class="hidden overflow-x-auto md:block">
              <table class="w-full text-left text-sm">
                <thead
                  class="text-xs uppercase tracking-wide"
                  style="background: var(--hi5-card-soft); color: var(--hi5-muted);"
                >
                  <tr>
                    <th class="px-5 py-3">Device</th>
                    <th class="px-5 py-3">Status</th>
                    <th class="px-5 py-3">Health</th>
                    <th class="px-5 py-3">Patches</th>
                  </tr>
                </thead>

                <tbody>
                  {devices.map((device) => (
                    <tr class="border-t" style="border-color: var(--hi5-border);">
                      <td class="px-5 py-4">
                        <div class="font-bold" style="color: var(--hi5-fg);">
                          {device.name}
                        </div>
                        <div class="text-xs" style="color: var(--hi5-muted);">
                          {device.user} · {device.os}
                        </div>
                      </td>

                      <td class="px-5 py-4">
                        {device.status === "Online" ? (
                          <Badge variant="success">Online</Badge>
                        ) : (
                          <Badge>Offline</Badge>
                        )}
                      </td>

                      <td class="px-5 py-4" style="color: var(--hi5-muted);">
                        {device.health}
                      </td>

                      <td class="px-5 py-4" style="color: var(--hi5-muted);">
                        {device.patches}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </Card>

          <aside class="space-y-6">
            <section
              class="rounded-3xl border p-5 text-white shadow-[var(--hi5-shadow)]"
              style="background: linear-gradient(135deg, var(--hi5-navy), var(--hi5-navy-soft)); border-color: rgba(255,255,255,0.08);"
            >
              <div class="flex items-center justify-between">
                <h3 class="text-lg font-black">Remote Access</h3>
                <Badge variant="dark">Ready</Badge>
              </div>

              <p class="mt-3 text-sm leading-6 text-slate-300">
                Sessions will use separate stream and input paths to avoid laggy mouse movement.
              </p>

              <div class="mt-5 grid grid-cols-2 gap-3">
                <Button variant="secondary">Connect</Button>
                <Button variant="dark">Background</Button>
              </div>
            </section>

            <Card class="p-5">
              <h3 class="text-lg font-black" style="color: var(--hi5-fg);">
                Backup Status
              </h3>

              <p class="mt-2 text-sm leading-6" style="color: var(--hi5-muted);">
                Managed customers will use Hi5Central-managed encrypted object storage.
              </p>

              <div
                class="mt-4 rounded-2xl border p-4"
                style="background: var(--hi5-card-soft); border-color: var(--hi5-border);"
              >
                <p class="text-sm font-bold" style="color: var(--hi5-fg);">
                  Protected Devices
                </p>
                <p class="mt-1 text-3xl font-black" style="color: var(--hi5-fg);">
                  0
                </p>
                <p class="mt-1 text-xs" style="color: var(--hi5-muted);">
                  Backup engine will be added later.
                </p>
              </div>
            </Card>
          </aside>
        </div>
      </section>
    </AppShell>
  </body>
</html>
