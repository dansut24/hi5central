---
import AppShell from "../../components/AppShell.astro";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Dashboard | Hi5Central</title>
  </head>

  <body>
    <AppShell title="Dashboard">
      <div class="mx-auto w-full max-w-[920px] space-y-4 lg:max-w-none">
        <section class="hi5-panel p-5">
          <p class="text-xs font-bold uppercase tracking-wide text-blue-300">Tenant dashboard</p>
          <h1 class="mt-2 text-2xl font-black text-white">
            Welcome to <span id="tenant-name">Hi5Central</span>
          </h1>
          <p class="mt-2 text-sm leading-6 text-slate-400">
            Monitor devices, actions, onboarding progress, and platform health from one place.
          </p>
        </section>

        <section class="grid grid-cols-2 gap-3 lg:grid-cols-4">
          <article class="hi5-panel p-4">
            <p class="text-xs text-slate-400">Devices</p>
            <p id="total-devices" class="mt-2 text-2xl font-black text-white">—</p>
          </article>

          <article class="hi5-panel p-4">
            <p class="text-xs text-slate-400">Online</p>
            <p id="online-devices" class="mt-2 text-2xl font-black text-emerald-300">—</p>
          </article>

          <article class="hi5-panel p-4">
            <p class="text-xs text-slate-400">Warning</p>
            <p id="warning-devices" class="mt-2 text-2xl font-black text-amber-300">—</p>
          </article>

          <article class="hi5-panel p-4">
            <p class="text-xs text-slate-400">Offline</p>
            <p id="offline-devices" class="mt-2 text-2xl font-black text-red-300">—</p>
          </article>
        </section>

        <section class="grid gap-4 lg:grid-cols-[1.1fr_0.9fr]">
          <section class="hi5-panel p-5">
            <div class="flex items-start justify-between gap-3">
              <div>
                <h2 class="text-sm font-semibold text-white">Getting Started</h2>
                <p class="mt-2 text-sm text-slate-400">Complete these steps to make this tenant production ready.</p>
              </div>
            </div>

            <div class="mt-4 space-y-2">
              <div class="hi5-soft-card flex items-center gap-3 p-3">
                <span class="grid h-7 w-7 place-items-center rounded-full bg-emerald-400/10 text-xs font-black text-emerald-300">✓</span>
                <div>
                  <p class="text-sm font-bold text-white">Create tenant</p>
                  <p class="text-xs text-slate-400">Tenant record created from signup.</p>
                </div>
              </div>

              <div class="hi5-soft-card flex items-center gap-3 p-3">
                <span class="grid h-7 w-7 place-items-center rounded-full bg-emerald-400/10 text-xs font-black text-emerald-300">✓</span>
                <div>
                  <p class="text-sm font-bold text-white">Verify email</p>
                  <p class="text-xs text-slate-400">Confirmation email completed.</p>
                </div>
              </div>

              <div class="hi5-soft-card flex items-center gap-3 p-3">
                <span class="grid h-7 w-7 place-items-center rounded-full bg-emerald-400/10 text-xs font-black text-emerald-300">✓</span>
                <div>
                  <p class="text-sm font-bold text-white">Complete onboarding</p>
                  <p class="text-xs text-slate-400">Initial setup has been started.</p>
                </div>
              </div>

              <div class="hi5-soft-card flex items-center gap-3 p-3">
                <span class="grid h-7 w-7 place-items-center rounded-full bg-slate-400/10 text-xs font-black text-slate-300">□</span>
                <div>
                  <p class="text-sm font-bold text-white">Download agent</p>
                  <p class="text-xs text-slate-400">Create the first device enrolment package.</p>
                </div>
              </div>

              <div class="hi5-soft-card flex items-center gap-3 p-3">
                <span class="grid h-7 w-7 place-items-center rounded-full bg-slate-400/10 text-xs font-black text-slate-300">□</span>
                <div>
                  <p class="text-sm font-bold text-white">Enrol first device</p>
                  <p class="text-xs text-slate-400">Connect a Windows, macOS, or Linux endpoint.</p>
                </div>
              </div>
            </div>
          </section>

          <section class="space-y-4">
            <section class="hi5-panel p-5">
              <h2 class="text-sm font-semibold text-white">Quick Actions</h2>

              <div class="mt-4 grid gap-2">
                <a href="/devices" class="rounded-2xl bg-white px-4 py-3 text-sm font-black text-slate-950">
                  View devices
                </a>

                <a href="/onboarding" class="hi5-card px-4 py-3 text-sm font-black text-white">
                  Continue onboarding
                </a>

                <button class="hi5-card px-4 py-3 text-left text-sm font-black text-white">
                  Download agent package
                </button>
              </div>
            </section>

            <section class="hi5-panel p-5">
              <h2 class="text-sm font-semibold text-white">Recent Activity</h2>
              <div id="recent-activity" class="mt-4 space-y-2">
                <div class="hi5-soft-card p-3 text-sm text-slate-400">
                  No recent activity yet.
                </div>
              </div>
            </section>
          </section>
        </section>
      </div>

      <script>
        const tenantSlug = window.location.hostname.split(".")[0] || "app";
        const tenantName = document.getElementById("tenant-name");
        if (tenantName) tenantName.textContent = tenantSlug === "app" ? "Hi5Central" : tenantSlug;

        async function loadMetrics() {
          try {
            const response = await fetch("/api/dashboard/metrics");
            const data = await response.json();

            if (!data.success) return;

            document.getElementById("total-devices").textContent = data.metrics.totalDevices ?? 0;
            document.getElementById("online-devices").textContent = data.metrics.onlineDevices ?? 0;
            document.getElementById("warning-devices").textContent = data.metrics.warningDevices ?? 0;
            document.getElementById("offline-devices").textContent = data.metrics.offlineDevices ?? 0;
          } catch {
            document.getElementById("total-devices").textContent = "0";
            document.getElementById("online-devices").textContent = "0";
            document.getElementById("warning-devices").textContent = "0";
            document.getElementById("offline-devices").textContent = "0";
          }
        }

        loadMetrics();
      </script>
    </AppShell>
  </body>
</html>
