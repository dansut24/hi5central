---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import { requireCurrentUser } from "../../lib/routeGuards";

const authPreviewEnabled = false;

if (authPreviewEnabled) {
  const guard = await requireCurrentUser();

  if (!guard.authenticated) {
    return Astro.redirect(guard.redirectTo);
  }
}

const currentUserPreview = {
  name: "Hi5Central Admin",
  email: "admin@hi5central.local",
  tenant: "Hi5Central Demo",
  role: "owner"
};
---

<DashboardLayout title="Dashboard">
  <div class="space-y-6">
    <section
      class="rounded-3xl border p-6"
      style="background: var(--hi5-card); border-color: var(--hi5-border);"
    >
      <p class="text-sm font-bold" style="color: var(--hi5-primary);">
        Authenticated Dashboard
      </p>

      <h1
        class="mt-2 text-3xl font-black"
        style="color: var(--hi5-fg);"
      >
        Welcome back, {currentUserPreview.name}
      </h1>

      <p
        class="mt-2 text-base"
        style="color: var(--hi5-muted);"
      >
        Signed in as {currentUserPreview.email} · {currentUserPreview.tenant} · {currentUserPreview.role}
      </p>
    </section>

    <div class="grid gap-4 md:grid-cols-3">
      <div
        class="rounded-2xl border p-6"
        style="background: var(--hi5-card); border-color: var(--hi5-border);"
      >
        <p class="text-sm font-bold" style="color: var(--hi5-muted);">Devices</p>
        <p class="mt-2 text-3xl font-black" style="color: var(--hi5-fg);">0</p>
      </div>

      <div
        class="rounded-2xl border p-6"
        style="background: var(--hi5-card); border-color: var(--hi5-border);"
      >
        <p class="text-sm font-bold" style="color: var(--hi5-muted);">Remote Sessions</p>
        <p class="mt-2 text-3xl font-black" style="color: var(--hi5-fg);">0</p>
      </div>

      <div
        class="rounded-2xl border p-6"
        style="background: var(--hi5-card); border-color: var(--hi5-border);"
      >
        <p class="text-sm font-bold" style="color: var(--hi5-muted);">Patch Exposure</p>
        <p class="mt-2 text-3xl font-black" style="color: var(--hi5-fg);">0</p>
      </div>
    </div>
  </div>
</DashboardLayout>
