---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import { requireCurrentUser } from "../../lib/routeGuards";
import StatCard from "../../components/dashboard/StatCard.astro";

const enforceAuth = false;

if (enforceAuth) {
  const guard = await requireCurrentUser();

  if (!guard.authenticated) {
    return Astro.redirect(guard.redirectTo);
  }
}

const currentUserPreview = {
  name: "Hi5Central Admin",
  email: "admin@hi5central.local",
  tenant: "Hi5Central Demo",
  role: "owner"
};
---

<DashboardLayout title="Dashboard">
  <div class="space-y-6">
    <section
      class="rounded-3xl border p-6"
      style="background: var(--hi5-card); border-color: var(--hi5-border);"
    >
      <p class="text-sm font-bold" style="color: var(--hi5-primary);">
        Authenticated Dashboard
      </p>

      <h1
        class="mt-2 text-3xl font-black"
        style="color: var(--hi5-fg);"
      >
        Welcome back, {currentUserPreview.name}
      </h1>

      <p
        class="mt-2 text-base"
        style="color: var(--hi5-muted);"
      >
        Signed in as {currentUserPreview.email}
      </p>
    </section>

    <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
      <StatCard
        title="Devices"
        value="0"
        description="Managed devices"
      />

      <StatCard
        title="Online Devices"
        value="0"
        description="Currently connected"
      />

      <StatCard
        title="Remote Sessions"
        value="0"
        description="Active sessions"
      />

      <StatCard
        title="Patch Compliance"
        value="100%"
        description="Placeholder value"
      />

      <StatCard
        title="Protected Devices"
        value="0"
        description="Backup enabled"
      />

      <StatCard
        title="Open Alerts"
        value="0"
        description="Monitoring alerts"
      />
    </div>
  </div>
</DashboardLayout>
