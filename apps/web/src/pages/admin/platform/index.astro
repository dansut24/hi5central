---
import PlatformAdminShell from "../../../components/platform-admin/PlatformAdminShell.astro";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Platform Admin | Hi5Central</title>
  </head>

  <body>
    <PlatformAdminShell title="Platform Admin">
      <div class="mx-auto w-full max-w-[1100px] space-y-4">
        <section class="hi5-panel p-5">
          <p class="text-xs font-bold uppercase tracking-wide text-blue-300">Hi5Central Staff</p>
          <h1 class="mt-2 text-2xl font-black text-white">Platform Admin</h1>
          <p class="mt-2 text-sm leading-6 text-slate-400">
            Manage the Hi5Central platform, customer tenants, users, trials, and system operations.
          </p>
        </section>

        <section class="grid grid-cols-2 gap-3 lg:grid-cols-4">
          <article class="hi5-panel p-4">
            <p class="text-xs text-slate-400">Tenants</p>
            <p id="tenant-count" class="mt-2 text-2xl font-black text-white">—</p>
          </article>

          <article class="hi5-panel p-4">
            <p class="text-xs text-slate-400">Users</p>
            <p id="user-count" class="mt-2 text-2xl font-black text-white">—</p>
          </article>

          <article class="hi5-panel p-4">
            <p class="text-xs text-slate-400">Trials</p>
            <p id="trial-count" class="mt-2 text-2xl font-black text-blue-300">—</p>
          </article>

          <article class="hi5-panel p-4">
            <p class="text-xs text-slate-400">Active</p>
            <p id="active-count" class="mt-2 text-2xl font-black text-emerald-300">—</p>
          </article>
        </section>

        <section class="grid gap-4 lg:grid-cols-2">
          <section class="hi5-panel p-5">
            <h2 class="text-sm font-semibold text-white">Management</h2>
            <p class="mt-2 text-sm text-slate-400">
              Common platform administration tasks.
            </p>

            <div class="mt-4 grid gap-2">
              <a href="/admin/platform/tenants" class="rounded-2xl bg-white px-4 py-3 text-sm font-black text-slate-950">
                Manage tenants
              </a>

              <a href="/admin/platform/users" class="hi5-card px-4 py-3 text-sm font-black text-white">
                Manage users
              </a>

              <button class="hi5-card px-4 py-3 text-left text-sm font-black text-white">
                Audit logs
              </button>

              <button class="hi5-card px-4 py-3 text-left text-sm font-black text-white">
                System health
              </button>
            </div>
          </section>

          <section class="hi5-panel p-5">
            <h2 class="text-sm font-semibold text-white">Admin Notes</h2>
            <div class="mt-4 space-y-2">
              <div class="hi5-soft-card p-3">
                <p class="text-sm font-bold text-white">Platform area</p>
                <p class="mt-1 text-xs leading-5 text-slate-400">
                  app.hi5central.com is reserved for Hi5Central staff and platform operations.
                </p>
              </div>

              <div class="hi5-soft-card p-3">
                <p class="text-sm font-bold text-white">Tenant area</p>
                <p class="mt-1 text-xs leading-5 text-slate-400">
                  customer.hi5central.com is for customer admins, technicians, and devices.
                </p>
              </div>

              <div class="hi5-soft-card p-3">
                <p class="text-sm font-bold text-white">Security</p>
                <p class="mt-1 text-xs leading-5 text-slate-400">
                  Platform admin APIs require platform_admin access.
                </p>
              </div>
            </div>
          </section>
        </section>
      </div>

      <script>
        async function loadPlatformStats() {
          try {
            const [tenantRes, userRes] = await Promise.all([
              fetch("/api/platform-admin/tenants"),
              fetch("/api/platform-admin/users")
            ]);

            const tenantData = await tenantRes.json();
            const userData = await userRes.json();

            if (!tenantRes.ok || !userRes.ok || !tenantData.success || !userData.success) {
              return;
            }

            const tenants = tenantData.tenants ?? [];
            const users = userData.users ?? [];

            const trials = tenants.filter((tenant) => tenant.plan === "trial").length;
            const active = tenants.filter((tenant) => tenant.status === "active").length;

            document.getElementById("tenant-count").textContent = tenants.length;
            document.getElementById("user-count").textContent = users.length;
            document.getElementById("trial-count").textContent = trials;
            document.getElementById("active-count").textContent = active;
          } catch {
            document.getElementById("tenant-count").textContent = "0";
            document.getElementById("user-count").textContent = "0";
            document.getElementById("trial-count").textContent = "0";
            document.getElementById("active-count").textContent = "0";
          }
        }

        loadPlatformStats();
      </script>
    </PlatformAdminShell>
  </body>
</html>
