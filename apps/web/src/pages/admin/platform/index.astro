---
import PlatformAdminShell from "../../../components/platform-admin/PlatformAdminShell.astro";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Platform Dashboard | Hi5Central</title>
  </head>

  <body>
    <PlatformAdminShell title="Platform Dashboard">
      <div class="mx-auto w-full max-w-[1200px] space-y-4">
        <section class="hi5-panel p-5">
          <p class="text-xs font-bold uppercase tracking-wide text-blue-300">Hi5Central Staff</p>
          <h1 class="mt-2 text-2xl font-black text-white">Platform Dashboard</h1>
          <p class="mt-2 text-sm leading-6 text-slate-400">
            Control plane overview for tenants, users, trials, activity, and platform operations.
          </p>
        </section>

        <section id="dashboard-grid" class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
          <div class="hi5-soft-card p-4 text-sm text-slate-400">Loading dashboard...</div>
        </section>

        <section class="grid gap-4 lg:grid-cols-[1fr_0.9fr]">
          <section class="hi5-panel p-5">
            <h2 class="text-sm font-semibold text-white">Platform Operations</h2>
            <p class="mt-2 text-sm text-slate-400">Quick links for common platform administration tasks.</p>

            <div class="mt-4 grid gap-2 sm:grid-cols-2">
              <a href="/admin/platform/tenants" class="rounded-2xl bg-white px-4 py-3 text-sm font-black text-slate-950">
                Manage tenants
              </a>

              <a href="/admin/platform/users" class="hi5-card px-4 py-3 text-sm font-black text-white">
                Manage users
              </a>

              <a href="/admin/platform/audit" class="hi5-card px-4 py-3 text-sm font-black text-white">
                View audit log
              </a>

              <a href="/admin/platform/system" class="hi5-card px-4 py-3 text-sm font-black text-white">
                System health
              </a>
            </div>
          </section>

          <section class="hi5-panel p-5">
            <h2 class="text-sm font-semibold text-white">Recent Summary</h2>

            <div class="mt-4 space-y-2">
              <div class="hi5-soft-card p-3">
                <p class="text-xs text-slate-400">New tenants this week</p>
                <p id="new-tenants" class="mt-1 text-xl font-black text-white">—</p>
              </div>

              <div class="hi5-soft-card p-3">
                <p class="text-xs text-slate-400">New users this week</p>
                <p id="new-users" class="mt-1 text-xl font-black text-white">—</p>
              </div>

              <div class="hi5-soft-card p-3">
                <p class="text-xs text-slate-400">Audit events in 24h</p>
                <p id="audit-events" class="mt-1 text-xl font-black text-white">—</p>
              </div>
            </div>
          </section>
        </section>
      </div>

      <script>
        function card(label, value, tone) {
          const toneClass = {
            default: "text-white",
            green: "text-emerald-300",
            blue: "text-blue-300",
            amber: "text-amber-300",
            purple: "text-purple-300",
            orange: "text-orange-300"
          }[tone || "default"];

          return `
            <article class="hi5-panel p-4">
              <p class="text-xs text-slate-400">${label}</p>
              <p class="mt-2 text-3xl font-black ${toneClass}">${value}</p>
            </article>
          `;
        }

        async function loadDashboard() {
          const grid = document.getElementById("dashboard-grid");

          try {
            const response = await fetch("/api/platform-admin/dashboard");
            const data = await response.json();

            if (!response.ok || !data.success) {
              throw new Error("dashboard_failed");
            }

            const m = data.metrics;

            grid.innerHTML = [
              card("Total Tenants", m.tenants, "default"),
              card("Active Tenants", m.active_tenants, "green"),
              card("Trial Tenants", m.trial_tenants, "blue"),
              card("Suspended", m.suspended_tenants, "amber"),
              card("Users", m.users, "default"),
              card("Active Users", m.active_users, "green"),
              card("Platform Admins", m.platform_admins, "purple"),
              card("Audit Events 24h", m.audit_events_24h, "orange")
            ].join("");

            document.getElementById("new-tenants").textContent = m.new_tenants_7d;
            document.getElementById("new-users").textContent = m.new_users_7d;
            document.getElementById("audit-events").textContent = m.audit_events_24h;
          } catch {
            grid.innerHTML = `
              <div class="rounded-2xl border border-red-400/20 bg-red-400/10 p-3 text-sm text-red-300">
                Could not load platform dashboard.
              </div>
            `;
          }
        }

        loadDashboard();
      </script>
    </PlatformAdminShell>
  </body>
</html>
