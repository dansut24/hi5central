---
import "../styles/global.css";
import ThemeSwitcher from "../components/ThemeSwitcher.astro";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Login · Hi5Central</title>
  </head>

  <body>
    <main class="flex min-h-screen items-center justify-center px-4 py-10">
      <section
        class="w-full max-w-md rounded-3xl border p-6 shadow-[var(--hi5-shadow)] md:p-8"
        style="background: var(--hi5-card); border-color: var(--hi5-border);"
      >
        <div class="flex items-center justify-between gap-4">
          <div class="flex items-center gap-3">
            <div
              class="flex h-12 w-12 items-center justify-center rounded-2xl text-lg font-black text-white shadow-lg"
              style="background: linear-gradient(135deg, var(--hi5-primary), #7c3aed);"
            >
              H5
            </div>

            <div>
              <p class="text-sm font-bold" style="color: var(--hi5-primary);">Hi5Central</p>
              <h1 class="text-2xl font-black tracking-tight" style="color: var(--hi5-fg);">Sign in</h1>
            </div>
          </div>

          <ThemeSwitcher compact={true} />
        </div>

        <p class="mt-6 text-sm leading-6" style="color: var(--hi5-muted);">
          Access your remote monitoring, remote access, patching, and backup platform.
        </p>

        <form class="mt-8 space-y-5" method="post">
          <div>
            <label class="block text-sm font-bold" style="color: var(--hi5-fg);" for="email">
              Email address
            </label>
            <input
              id="email"
              name="email"
              type="email"
              autocomplete="email"
              required
              placeholder="admin@company.com"
              class="mt-2 w-full rounded-2xl border px-4 py-3 text-sm outline-none transition focus:ring-4"
              style="background: var(--hi5-card-soft); border-color: var(--hi5-border); color: var(--hi5-fg); --tw-ring-color: color-mix(in srgb, var(--hi5-primary) 22%, transparent);"
            />
          </div>

          <div>
            <div class="flex items-center justify-between gap-3">
              <label class="block text-sm font-bold" style="color: var(--hi5-fg);" for="password">
                Password
              </label>

              <a class="text-sm font-bold" style="color: var(--hi5-primary);" href="#">
                Forgot password?
              </a>
            </div>

            <input
              id="password"
              name="password"
              type="password"
              autocomplete="current-password"
              required
              placeholder="••••••••••••"
              class="mt-2 w-full rounded-2xl border px-4 py-3 text-sm outline-none transition focus:ring-4"
              style="background: var(--hi5-card-soft); border-color: var(--hi5-border); color: var(--hi5-fg); --tw-ring-color: color-mix(in srgb, var(--hi5-primary) 22%, transparent);"
            />
          </div>

          <button
            type="submit"
            class="w-full rounded-2xl px-4 py-3 text-sm font-black text-white shadow-lg transition hover:-translate-y-0.5"
            style="background: var(--hi5-primary); box-shadow: 0 12px 24px color-mix(in srgb, var(--hi5-primary) 28%, transparent);"
          >
            Sign in
          </button>
        </form>

        <div
          class="mt-6 rounded-2xl border p-4 text-sm"
          style="background: var(--hi5-primary-soft); border-color: color-mix(in srgb, var(--hi5-primary) 18%, transparent); color: var(--hi5-muted);"
        >
          <p class="font-bold" style="color: var(--hi5-fg);">Development note</p>
          <p class="mt-1">
            This page is currently static. API login wiring will be added in the next pass.
          </p>
        </div>
      </section>
    </main>
  </body>
</html>
