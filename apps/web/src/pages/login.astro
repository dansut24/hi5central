---
import "../styles/global.css";
import ThemeSwitcher from "../components/ThemeSwitcher.astro";
import LoginForm from "../components/LoginForm.astro";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Login · Hi5Central</title>
  </head>

  <body>
    <main class="flex min-h-screen items-center justify-center px-4 py-10">
      <section
        class="w-full max-w-md rounded-3xl border p-6 shadow-[var(--hi5-shadow)] md:p-8"
        style="background: var(--hi5-card); border-color: var(--hi5-border);"
      >
        <div class="flex items-center justify-between gap-4">
          <div class="flex items-center gap-3">
            <div
              class="flex h-12 w-12 items-center justify-center rounded-2xl text-lg font-black text-white shadow-lg"
              style="background: linear-gradient(135deg, var(--hi5-primary), #7c3aed);"
            >
              H5
            </div>

            <div>
              <p class="text-sm font-bold" style="color: var(--hi5-primary);">Hi5Central</p>
              <h1 class="text-2xl font-black tracking-tight" style="color: var(--hi5-fg);">Sign in</h1>
            </div>
          </div>

          <ThemeSwitcher compact={true} />
        </div>

        <p class="mt-6 text-sm leading-6" style="color: var(--hi5-muted);">
          Access your remote monitoring, remote access, patching, and backup platform.
        </p>

        <LoginForm />
      </section>
    </main>
  </body>
</html>
