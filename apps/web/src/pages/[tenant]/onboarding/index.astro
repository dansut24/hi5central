---
import AppShell from "../../../components/AppShell.astro";

const tenant = Astro.params.tenant;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Onboarding | Hi5Central</title>
  </head>

  <body>
    <AppShell title="Onboarding">
      <div class="mx-auto w-full max-w-[720px] space-y-4 lg:max-w-none">
        <section class="hi5-panel p-5">
          <p class="text-xs font-bold uppercase tracking-wide text-blue-300">Welcome to Hi5Central</p>
          <h1 class="mt-2 text-2xl font-black text-white">Set up your workspace</h1>
          <p class="mt-2 text-sm leading-6 text-slate-400">
            Your tenant has been created. Complete these steps to finish your initial setup.
          </p>

          <div class="mt-4 rounded-2xl border border-blue-400/20 bg-blue-400/10 p-3">
            <p class="text-xs font-bold text-blue-200">Tenant</p>
            <p class="mt-1 text-sm font-semibold text-white">{tenant}</p>
          </div>
        </section>

        <section class="grid gap-3 md:grid-cols-3">
          <article class="hi5-panel p-4">
            <p class="text-sm font-bold text-white">1. Company profile</p>
            <p class="mt-2 text-xs leading-5 text-slate-400">Confirm company details and branding.</p>
          </article>

          <article class="hi5-panel p-4">
            <p class="text-sm font-bold text-white">2. Add technicians</p>
            <p class="mt-2 text-xs leading-5 text-slate-400">Invite users who will manage devices.</p>
          </article>

          <article class="hi5-panel p-4">
            <p class="text-sm font-bold text-white">3. Enrol devices</p>
            <p class="mt-2 text-xs leading-5 text-slate-400">Download the agent and add your first endpoint.</p>
          </article>
        </section>

        <section class="hi5-panel p-5">
          <h2 class="text-sm font-semibold text-white">Next step</h2>
          <p class="mt-2 text-sm leading-6 text-slate-400">
            For now, continue to the Control dashboard. The full onboarding wizard will be expanded in the next pass.
          </p>

          <a href="/dashboard" class="mt-4 inline-flex rounded-2xl bg-white px-4 py-3 text-sm font-black text-slate-950">
            Go to dashboard
          </a>
        </section>
      </div>
    </AppShell>
  </body>
</html>
