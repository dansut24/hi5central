---
import AppShell from "../../components/AppShell.astro";

const deviceId = Astro.params.id;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Device Details | Hi5Central</title>
  </head>

  <body>
    <AppShell title="Device Details">
      <div class="mx-auto w-full max-w-[720px] space-y-4 lg:max-w-none">
        <section class="hi5-panel p-4">
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
              <p class="text-xs font-bold uppercase tracking-wide text-blue-300">Device Details</p>
              <h1 id="device-title" class="mt-2 truncate text-2xl font-black text-white">Loading device...</h1>
              <p id="device-os" class="mt-1 truncate text-sm text-slate-400">Please wait.</p>
            </div>

            <span id="device-status-pill" class="shrink-0 rounded-full border border-slate-400/20 bg-slate-400/10 px-3 py-1 text-xs font-bold text-slate-300">
              —
            </span>
          </div>
        </section>

        <nav class="hi5-panel flex gap-2 overflow-x-auto p-2 no-scrollbar" aria-label="Device sections">
          <button data-tab="overview" class="device-tab shrink-0 rounded-2xl px-4 py-2 text-sm font-bold">Overview</button>
          <button data-tab="hardware" class="device-tab shrink-0 rounded-2xl px-4 py-2 text-sm font-bold">Hardware</button>
          <button data-tab="software" class="device-tab shrink-0 rounded-2xl px-4 py-2 text-sm font-bold">Software</button>
          <button data-tab="tools" class="device-tab shrink-0 rounded-2xl px-4 py-2 text-sm font-bold">Tools</button>
          <button data-tab="actions" class="device-tab shrink-0 rounded-2xl px-4 py-2 text-sm font-bold">Actions</button>
          <button data-tab="settings" class="device-tab shrink-0 rounded-2xl px-4 py-2 text-sm font-bold">Settings</button>
        </nav>

        <section data-panel="overview" class="device-panel space-y-4">
          <section class="grid grid-cols-2 gap-3 lg:grid-cols-4">
            <article class="hi5-panel p-4"><p class="text-xs text-slate-400">Hostname</p><p id="device-hostname" class="mt-2 truncate text-sm font-semibold text-white">—</p></article>
            <article class="hi5-panel p-4"><p class="text-xs text-slate-400">Status</p><p id="device-status" class="mt-2 text-sm font-semibold capitalize text-white">—</p></article>
            <article class="hi5-panel p-4"><p class="text-xs text-slate-400">Agent</p><p id="device-agent" class="mt-2 text-sm font-semibold text-white">—</p></article>
            <article class="hi5-panel p-4"><p class="text-xs text-slate-400">Last Seen</p><p id="device-last-seen" class="mt-2 text-sm font-semibold text-white">—</p></article>
          </section>

          <section class="hi5-panel p-4">
            <h2 class="text-sm font-semibold text-white">Network</h2>
            <div class="mt-3 grid grid-cols-2 gap-3">
              <div class="hi5-soft-card p-3"><p class="text-xs text-slate-400">Public IP</p><p id="device-public-ip" class="mt-1 truncate text-sm font-semibold text-white">—</p></div>
              <div class="hi5-soft-card p-3"><p class="text-xs text-slate-400">Local IP</p><p id="device-local-ip" class="mt-1 truncate text-sm font-semibold text-white">—</p></div>
            </div>
          </section>
        </section>

        <section data-panel="hardware" class="device-panel hidden space-y-4">
          <section class="hi5-panel p-4">
            <h2 class="text-sm font-semibold text-white">Hardware Inventory</h2>
            <div class="mt-3 grid grid-cols-2 gap-3 lg:grid-cols-4">
              <div class="hi5-soft-card p-3"><p class="text-xs text-slate-400">CPU</p><p id="device-cpu" class="mt-1 truncate text-sm font-semibold text-white">—</p></div>
              <div class="hi5-soft-card p-3"><p class="text-xs text-slate-400">RAM</p><p id="device-ram" class="mt-1 truncate text-sm font-semibold text-white">—</p></div>
              <div class="hi5-soft-card p-3"><p class="text-xs text-slate-400">Disk</p><p id="device-disk" class="mt-1 truncate text-sm font-semibold text-white">—</p></div>
              <div class="hi5-soft-card p-3"><p class="text-xs text-slate-400">GPU</p><p id="device-gpu" class="mt-1 truncate text-sm font-semibold text-white">—</p></div>
              <div class="hi5-soft-card p-3"><p class="text-xs text-slate-400">Logged In User</p><p id="device-user" class="mt-1 truncate text-sm font-semibold text-white">—</p></div>
              <div class="hi5-soft-card p-3"><p class="text-xs text-slate-400">BitLocker</p><p id="device-bitlocker" class="mt-1 truncate text-sm font-semibold text-white">—</p></div>
              <div class="hi5-soft-card p-3"><p class="text-xs text-slate-400">TPM</p><p id="device-tpm" class="mt-1 truncate text-sm font-semibold text-white">—</p></div>
            </div>
          </section>
        </section>

        <section data-panel="software" class="device-panel hidden space-y-4">
          <section class="hi5-panel p-4">
            <h2 class="text-sm font-semibold text-white">Software Inventory</h2>
            <p class="mt-2 text-sm leading-6 text-slate-400">Installed applications, patch status, CVEs, and update actions will appear here.</p>
          </section>
        </section>

        <section data-panel="tools" class="device-panel hidden space-y-4">
          <section class="hi5-panel p-4">
            <h2 class="text-sm font-semibold text-white">Remote Tools</h2>
            <div class="mt-3 grid grid-cols-2 gap-2 lg:grid-cols-3">
              <button class="rounded-2xl bg-white px-3 py-3 text-xs font-bold text-slate-950">Remote Control</button>
              <button class="hi5-card px-3 py-3 text-xs font-bold text-white">Terminal</button>
              <button class="hi5-card px-3 py-3 text-xs font-bold text-white">File Browser</button>
              <button class="hi5-card px-3 py-3 text-xs font-bold text-white">PowerShell</button>
              <button class="hi5-card px-3 py-3 text-xs font-bold text-white">Services</button>
              <button class="hi5-card px-3 py-3 text-xs font-bold text-white">Processes</button>
            </div>
          </section>
        </section>

        <section data-panel="actions" class="device-panel hidden space-y-4">
          <section class="hi5-panel p-4">
            <h2 class="text-sm font-semibold text-white">Actions</h2>
            <p class="mt-2 text-sm leading-6 text-slate-400">Create and review queued actions for this device.</p>

            <div class="mt-4 grid grid-cols-1 gap-2 sm:grid-cols-3">
              <button data-create-action="refresh_inventory" class="rounded-2xl bg-white px-3 py-3 text-xs font-bold text-slate-950">Refresh Inventory</button>
              <button data-create-action="reboot" class="hi5-card px-3 py-3 text-xs font-bold text-white">Reboot</button>
              <button data-create-action="shutdown" class="hi5-card px-3 py-3 text-xs font-bold text-white">Shutdown</button>
            </div>

            <div id="action-create-result" class="mt-3 hidden rounded-2xl border border-blue-400/20 bg-blue-400/10 p-3 text-sm text-blue-200"></div>
          </section>

          <section class="hi5-panel p-4">
            <div class="flex items-center justify-between gap-3">
              <div>
                <h2 class="text-sm font-semibold text-white">Action History</h2>
                <p class="mt-1 text-xs text-slate-400">Latest queued and completed actions.</p>
              </div>

              <button id="refresh-actions" class="hi5-card px-3 py-2 text-xs font-bold text-blue-200">Refresh</button>
            </div>

            <div id="actions-list" class="mt-3 space-y-2">
              <div class="hi5-soft-card p-3 text-sm text-slate-400">Loading actions...</div>
            </div>
          </section>
        </section>

        <section data-panel="settings" class="device-panel hidden space-y-4">
          <section class="hi5-panel p-4">
            <h2 class="text-sm font-semibold text-white">Device Settings</h2>
            <p class="mt-2 text-sm leading-6 text-slate-400">Device group, policies, maintenance mode, and agent configuration will appear here.</p>
          </section>
        </section>
      </div>

      <script define:vars={{ deviceId }}>
        const value = (v) => v ?? "—";

        function setText(id, text) {
          const el = document.getElementById(id);
          if (el) el.textContent = text;
        }

        function safe(value) {
          return String(value ?? "—")
            .replaceAll("&", "&amp;")
            .replaceAll("<", "&lt;")
            .replaceAll(">", "&gt;");
        }

        function formatDate(value) {
          if (!value) return "—";
          return new Date(value).toLocaleString();
        }

        function actionBadge(status) {
          const s = String(status ?? "pending").toLowerCase();
          if (s === "completed") return "border-emerald-400/20 bg-emerald-400/10 text-emerald-300";
          if (s === "failed") return "border-red-400/20 bg-red-400/10 text-red-300";
          if (s === "running") return "border-blue-400/20 bg-blue-400/10 text-blue-300";
          return "border-amber-400/20 bg-amber-400/10 text-amber-300";
        }

        function setStatusPill(status) {
          const el = document.getElementById("device-status-pill");
          if (!el) return;
          const s = String(status ?? "unknown").toLowerCase();
          el.textContent = s;
          el.className = s === "online"
            ? "shrink-0 rounded-full border border-emerald-400/20 bg-emerald-400/10 px-3 py-1 text-xs font-bold capitalize text-emerald-300"
            : s === "warning"
              ? "shrink-0 rounded-full border border-amber-400/20 bg-amber-400/10 px-3 py-1 text-xs font-bold capitalize text-amber-300"
              : "shrink-0 rounded-full border border-slate-400/20 bg-slate-400/10 px-3 py-1 text-xs font-bold capitalize text-slate-300";
        }

        function setTab(activeTab) {
          document.querySelectorAll(".device-tab").forEach((button) => {
            const isActive = button.dataset.tab === activeTab;
            button.style.background = isActive ? "rgb(37 99 235 / 0.22)" : "transparent";
            button.style.color = isActive ? "rgb(191 219 254)" : "rgb(148 163 184)";
            button.style.border = isActive ? "1px solid rgb(96 165 250 / 0.28)" : "1px solid transparent";
          });

          document.querySelectorAll(".device-panel").forEach((panel) => {
            panel.classList.toggle("hidden", panel.dataset.panel !== activeTab);
          });

          const url = new URL(window.location.href);
          url.searchParams.set("tab", activeTab);
          window.history.replaceState({}, "", url);
        }

        async function loadDevice() {
          const response = await fetch(`/api/devices/${deviceId}`);
          const data = await response.json();

          if (!data.success || !data.device) {
            setText("device-title", "Device not found");
            return;
          }

          const d = data.device;

          setText("device-title", value(d.device_name));
          setText("device-os", `${value(d.operating_system)} ${d.os_version ?? ""}`);
          setText("device-hostname", value(d.hostname));
          setText("device-status", value(d.status));
          setStatusPill(d.status);
          setText("device-agent", value(d.agent_version));
          setText("device-last-seen", d.minutes_since_seen === null ? "Never" : `${d.minutes_since_seen} min ago`);
          setText("device-public-ip", value(d.public_ip));
          setText("device-local-ip", value(d.local_ip));
          setText("device-cpu", value(d.cpu));
          setText("device-ram", d.ram_gb ? `${d.ram_gb} GB` : "—");
          setText("device-disk", d.disk_gb ? `${d.disk_gb} GB` : "—");
          setText("device-gpu", value(d.gpu));
          setText("device-user", value(d.logged_in_user));
          setText("device-bitlocker", d.bitlocker_enabled === true ? "Enabled" : d.bitlocker_enabled === false ? "Disabled" : "—");
          setText("device-tpm", value(d.tpm_version));
        }

        async function loadActions() {
          const container = document.getElementById("actions-list");
          if (!container) return;

          try {
            const response = await fetch(`/api/devices/${deviceId}/actions`);
            const data = await response.json();

            if (!response.ok || !data.success) throw new Error("Failed to load actions");

            const actions = data.actions ?? [];

            if (!actions.length) {
              container.innerHTML = `<div class="hi5-soft-card p-3 text-sm text-slate-400">No actions queued yet.</div>`;
              return;
            }

            container.innerHTML = actions.map((action) => `
              <article class="hi5-soft-card p-3">
                <div class="flex items-start justify-between gap-3">
                  <div class="min-w-0">
                    <p class="truncate text-sm font-semibold text-white">${safe(action.action_type)}</p>
                    <p class="mt-1 text-xs text-slate-400">Created: ${formatDate(action.created_at)}</p>
                    <p class="mt-1 text-xs text-slate-500">Completed: ${formatDate(action.completed_at)}</p>
                    ${action.error ? `<p class="mt-2 text-xs text-red-300">${safe(action.error)}</p>` : ""}
                  </div>

                  <span class="shrink-0 rounded-full border px-2.5 py-1 text-[11px] font-bold ${actionBadge(action.status)}">
                    ${safe(action.status)}
                  </span>
                </div>
              </article>
            `).join("");
          } catch {
            container.innerHTML = `<div class="rounded-2xl border border-red-400/20 bg-red-400/10 p-3 text-sm text-red-300">Could not load actions.</div>`;
          }
        }

        async function createAction(actionType) {
          const result = document.getElementById("action-create-result");

          try {
            const response = await fetch(`/api/devices/${deviceId}/actions`, {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ action_type: actionType, payload: {} })
            });

            const data = await response.json();

            if (!response.ok || !data.success) throw new Error(data.error || "Failed to create action");

            if (result) {
              result.classList.remove("hidden");
              result.textContent = `Queued action: ${actionType}`;
            }

            await loadActions();
          } catch (error) {
            if (result) {
              result.classList.remove("hidden");
              result.textContent = `Could not queue action: ${error.message}`;
            }
          }
        }

        document.querySelectorAll(".device-tab").forEach((button) => {
          button.addEventListener("click", () => setTab(button.dataset.tab || "overview"));
        });

        document.querySelectorAll("[data-create-action]").forEach((button) => {
          button.addEventListener("click", () => createAction(button.dataset.createAction));
        });

        document.getElementById("refresh-actions")?.addEventListener("click", loadActions);

        const initialTab = new URL(window.location.href).searchParams.get("tab") || "overview";
        setTab(initialTab);

        loadDevice().catch(() => setText("device-title", "Could not load device"));
        loadActions();
      </script>
    </AppShell>
  </body>
</html>
