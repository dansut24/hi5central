---
import DashboardLayout from "../../layouts/DashboardLayout.astro";

const devices = [
  {
    name: "CEO-LAPTOP",
    hostname: "CEO-LAPTOP",
    os: "Windows 11 Pro 24H2",
    status: "online",
    agent: "1.0.0",
    lastSeen: "Just now"
  },
  {
    name: "HELPDESK-01",
    hostname: "HELPDESK-01",
    os: "Windows 11 Pro 24H2",
    status: "online",
    agent: "1.0.0",
    lastSeen: "Just now"
  },
  {
    name: "DC-01",
    hostname: "DC-01",
    os: "Windows Server 2025",
    status: "online",
    agent: "1.0.0",
    lastSeen: "Just now"
  },
  {
    name: "FILE-01",
    hostname: "FILE-01",
    os: "Windows Server 2022",
    status: "warning",
    agent: "1.0.0",
    lastSeen: "Just now"
  },
  {
    name: "MACBOOK-PRO",
    hostname: "MACBOOK-PRO",
    os: "macOS Sonoma 14",
    status: "offline",
    agent: "1.0.0",
    lastSeen: "1 day ago"
  },
  {
    name: "UBUNTU-DEV",
    hostname: "UBUNTU-DEV",
    os: "Ubuntu 24.04",
    status: "online",
    agent: "1.0.0",
    lastSeen: "Just now"
  }
];

function statusStyle(status: string) {
  if (status === "online") {
    return "background: color-mix(in srgb, var(--hi5-success) 12%, transparent); color: var(--hi5-success); border-color: color-mix(in srgb, var(--hi5-success) 25%, transparent);";
  }

  if (status === "warning") {
    return "background: color-mix(in srgb, var(--hi5-warning) 12%, transparent); color: var(--hi5-warning); border-color: color-mix(in srgb, var(--hi5-warning) 25%, transparent);";
  }

  return "background: var(--hi5-card-soft); color: var(--hi5-muted); border-color: var(--hi5-border);";
}
---

<DashboardLayout title="Devices">
  <div class="space-y-6">
    <section
      class="rounded-3xl border p-6"
      style="background: var(--hi5-card); border-color: var(--hi5-border);"
    >
      <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
        <div>
          <p class="text-sm font-bold" style="color: var(--hi5-primary);">
            Device Inventory
          </p>

          <h1
            class="mt-2 text-3xl font-black"
            style="color: var(--hi5-fg);"
          >
            Managed Devices
          </h1>

          <p
            class="mt-2 text-base"
            style="color: var(--hi5-muted);"
          >
            View enrolled devices, status, agent version, and last check-in.
          </p>
        </div>

        <button
          type="button"
          class="rounded-2xl px-4 py-3 text-sm font-black text-white shadow-lg"
          style="background: var(--hi5-primary);"
        >
          Add Device
        </button>
      </div>
    </section>

    <section
      class="hidden overflow-hidden rounded-3xl border md:block"
      style="background: var(--hi5-card); border-color: var(--hi5-border);"
    >
      <table class="w-full text-left text-sm">
        <thead
          class="border-b"
          style="background: var(--hi5-card-soft); border-color: var(--hi5-border); color: var(--hi5-muted);"
        >
          <tr>
            <th class="px-5 py-4">Device</th>
            <th class="px-5 py-4">Operating System</th>
            <th class="px-5 py-4">Status</th>
            <th class="px-5 py-4">Agent</th>
            <th class="px-5 py-4">Last Seen</th>
          </tr>
        </thead>

        <tbody>
          {devices.map((device) => (
            <tr
              class="border-b last:border-b-0"
              style="border-color: var(--hi5-border);"
            >
              <td class="px-5 py-4">
                <p class="font-bold" style="color: var(--hi5-fg);">
                  {device.name}
                </p>
                <p class="text-xs" style="color: var(--hi5-muted);">
                  {device.hostname}
                </p>
              </td>

              <td class="px-5 py-4" style="color: var(--hi5-muted);">
                {device.os}
              </td>

              <td class="px-5 py-4">
                <span
                  class="rounded-full border px-3 py-1 text-xs font-bold capitalize"
                  style={statusStyle(device.status)}
                >
                  {device.status}
                </span>
              </td>

              <td class="px-5 py-4" style="color: var(--hi5-muted);">
                {device.agent}
              </td>

              <td class="px-5 py-4" style="color: var(--hi5-muted);">
                {device.lastSeen}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="space-y-3 md:hidden">
      {devices.map((device) => (
        <article
          class="rounded-3xl border p-5"
          style="background: var(--hi5-card); border-color: var(--hi5-border);"
        >
          <div class="flex items-start justify-between gap-4">
            <div>
              <h2 class="font-black" style="color: var(--hi5-fg);">
                {device.name}
              </h2>

              <p class="text-sm" style="color: var(--hi5-muted);">
                {device.os}
              </p>
            </div>

            <span
              class="rounded-full border px-3 py-1 text-xs font-bold capitalize"
              style={statusStyle(device.status)}
            >
              {device.status}
            </span>
          </div>

          <div class="mt-4 grid grid-cols-2 gap-3 text-sm">
            <div>
              <p style="color: var(--hi5-muted);">Hostname</p>
              <p class="font-bold" style="color: var(--hi5-fg);">
                {device.hostname}
              </p>
            </div>

            <div>
              <p style="color: var(--hi5-muted);">Agent</p>
              <p class="font-bold" style="color: var(--hi5-fg);">
                {device.agent}
              </p>
            </div>

            <div>
              <p style="color: var(--hi5-muted);">Last Seen</p>
              <p class="font-bold" style="color: var(--hi5-fg);">
                {device.lastSeen}
              </p>
            </div>
          </div>
        </article>
      ))}
    </section>
  </div>
</DashboardLayout>
