{
  "name": "@hi5central/db",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc --noEmit",
    "migrate:create": "node-pg-migrate create --migrations-dir migrations",
